# ============================================
# 园区设备知识库问答 Demo 环境变量模板
# 复制为 .env 后填入你的 Key（.env 已被 gitignore）
# 不配置任何 Key 时，服务自动进入 MOCK 模式，可离线跑通全链路
# ============================================

# ---- 对话模型（用于生成回答）----
# DeepSeek : https://api.deepseek.com/v1         模型 deepseek-chat
# 通义千问 : https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
# OpenAI   : https://api.openai.com/v1           模型 gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-请替换为你的对话模型Key
LLM_MODEL=deepseek-chat

# ---- Embedding 向量模型（DeepSeek 没有向量接口，需另配一家）----
# provider: dashscope | siliconflow | openai
EMBEDDING_PROVIDER=siliconflow
# SiliconFlow: https://api.siliconflow.cn/v1  模型 BAAI/bge-m3（bge-m3 中文效果好）
# OpenAI     : https://api.openai.com/v1      模型 text-embedding-3-small
# DashScope  : provider=dashscope 即可，无需 baseUrl，模型 text-embedding-v3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-请替换为你的向量模型Key
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 可选调优 ----
# PORT=3001                 # 后端端口
# RAG_TOP_K=5               # 检索返回条数
# RAG_THRESHOLD=0.1         # 相似度阈值（低于该值视为未命中）
# RAG_MAX_HISTORY_CHARS=4000# 多轮历史上下文长度上限（字符）
# MOCK_MODE=true            # 强制离线演示模式（不调用任何外部 API）
# VECTOR_STORE=sqlite       # 向量库：sqlite（默认）| json（零依赖回退）
